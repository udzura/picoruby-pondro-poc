{
  "name": "pondro-example2",
  "main": "../worker/index.js",
  "compatibility_date": "2026-10-03",
  "assets": { "directory": "../public", "binding": "ASSETS", "run_worker_first": ["/api/*", "/ws/*"] },
  "durable_objects": { "bindings": [{ "name": "PONDRO", "class_name": "PondroObject" }, { "name": "DEMO_ADMIN", "class_name": "DemoAdmin" }] },
  "ai": { "binding": "AI", "remote": true },
  "vars": { "EXAMPLE2_AI_MODE": "live" },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PondroObject"] }, { "tag": "v2", "new_sqlite_classes": ["DemoAdmin"] }],
  "rules": [{ "type": "CompiledWasm", "globs": ["**/*.wasm"], "fallthrough": true }]
}
