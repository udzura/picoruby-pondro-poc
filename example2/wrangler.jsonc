{
  "name": "pondro-example2",
  "main": "../worker/index.js",
  "compatibility_date": "2026-10-03",
  "assets": { "directory": "../public", "binding": "ASSETS", "run_worker_first": true },
  "secrets": { "required": ["BASIC_AUTH_USER", "BASIC_AUTH_PASSWORD"] },
  "durable_objects": { "bindings": [{ "name": "PONDRO", "class_name": "PondroObject" }] },
  "ai": { "binding": "AI", "remote": true },
  "vars": { "EXAMPLE2_AI_MODE": "live" },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PondroObject"] }],
  "rules": [{ "type": "CompiledWasm", "globs": ["**/*.wasm"], "fallthrough": true }]
}
