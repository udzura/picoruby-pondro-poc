{
  "name": "picoruby-pondro-poc",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-03",
  "assets": { "directory": "public", "binding": "ASSETS", "run_worker_first": ["/api/*", "/ws/*"] },
  "durable_objects": { "bindings": [{ "name": "PONDRO", "class_name": "PondroObject" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PondroObject"] }],
  "rules": [{ "type": "CompiledWasm", "globs": ["**/*.wasm"], "fallthrough": true }]
}
